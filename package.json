{
  "name": "zag",
  "version": "1.0.0",
  "author": "Mark <mark@remarkablemark.org>",
  "scripts": {
    "build": "npm run clean && vite build",
    "bundle": "bash scripts/bundle.sh",
    "clean": "rm -rf dist",
    "icons": "node scripts/icons.mts",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
